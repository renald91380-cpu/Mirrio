{
  "outputDirectory": "site",
  "crons": [
    {
      "path": "/api/relances",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/paiement-nettoyer",
      "schedule": "50 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
