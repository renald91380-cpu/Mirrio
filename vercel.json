{
  "outputDirectory": "site",
  "crons": [
    {
      "path": "/api/relances",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/paiement-nettoyer",
      "schedule": "50 6 * * *"
    },
    {
      "path": "/api/relances?tache=rappels",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/relances?tache=clotures",
      "schedule": "30 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(self \"https://js.stripe.com\")"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/reservation.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/annuaire",
      "destination": "/api/reservation-disponibilites?action=annuaire"
    },
    {
      "source": "/api/avis",
      "destination": "/api/reservation-disponibilites?action=avis"
    },
    {
      "source": "/api/rendez-vous-ics",
      "destination": "/api/reservation-disponibilites?action=ics"
    },
    {
      "source": "/api/vitrine",
      "destination": "/api/reservation-disponibilites?action=vitrine"
    },
    {
      "source": "/api/mon-espace",
      "destination": "/api/reservation-disponibilites?action=client"
    },
    {
      "source": "/api/gateaux",
      "destination": "/api/reservation-disponibilites?action=gateaux"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/reservation-disponibilites?action=sitemap"
    },
    {
      "source": "/api/mariage",
      "destination": "/api/reservation-disponibilites?action=mariage"
    },
    {
      "source": "/api/salons",
      "destination": "/api/reservation-disponibilites?action=salons"
    },
    {
      "source": "/api/caisse-terminal",
      "destination": "/api/reservation-disponibilites?action=terminal"
    },
    {
      "source": "/api/fidelite",
      "destination": "/api/reservation-disponibilites?action=fidelite"
    }
  ]
}