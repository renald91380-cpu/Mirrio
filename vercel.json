{
  "outputDirectory": "site",
  "crons": [
    {
      "path": "/api/relances",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/paiement-nettoyer",
      "schedule": "50 6 * * *"
    },
    {
      "path": "/api/relances?tache=rappels",
      "schedule": "0 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/annuaire",
      "destination": "/api/reservation-disponibilites?action=annuaire"
    },
    {
      "source": "/api/avis",
      "destination": "/api/reservation-disponibilites?action=avis"
    },
    {
      "source": "/api/rendez-vous-ics",
      "destination": "/api/reservation-disponibilites?action=ics"
    },
    {
      "source": "/api/vitrine",
      "destination": "/api/reservation-disponibilites?action=vitrine"
    },
    {
      "source": "/api/mon-espace",
      "destination": "/api/reservation-disponibilites?action=client"
    }
  ]
}
